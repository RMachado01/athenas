# Copie este arquivo para ".env.local" e preencha. O ".env.local" NUNCA vai para o Git.
#
# Onde achar: painel do Supabase > Project Settings > API (URL do projeto e a chave "publishable").
# A chave "publishable" é pública por desenho (a segurança vem da RLS). A chave SECRETA
# (service_role / sb_secret_…) só existe no servidor (variável de ambiente da Vercel).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Google Agenda (opcional; SÓ no servidor, nunca "NEXT_PUBLIC_") ---
# Sem estas três, a integração fica indisponível e o resto do app funciona normalmente.
# Em produção, configure na Vercel (Settings > Environment Variables), não neste arquivo.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# SUPABASE_SECRET_KEY=