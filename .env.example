# Copie este arquivo para ".env.local" e preencha. O ".env.local" NUNCA vai para o Git.
#
# Onde achar: painel do Supabase > Project Settings > API (URL do projeto e a chave "publishable").
# A chave "publishable" é pública por desenho (a segurança vem da RLS). A chave SECRETA
# (service_role / sb_secret_…) NÃO vai neste arquivo: ela só existe nas Edge Functions.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
